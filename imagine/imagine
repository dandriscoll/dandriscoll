#!/usr/bin/env bash
set -euo pipefail

IMAGINE_FILE="${IMAGINE_FILE:-$HOME/.imagine}"

cmd_install() {
    local bin_dir="$HOME/.local/bin"
    mkdir -p "$bin_dir"
    cp "$0" "$bin_dir/imagine"
    chmod +x "$bin_dir/imagine"

    # Set up .imagine file
    touch "$IMAGINE_FILE"

    # Attach login message to shell profile
    local login_line='command -v imagine >/dev/null 2>&1 && echo "imagine ls"'
    for rc in "$HOME/.bashrc" "$HOME/.zshrc"; do
        if [ -f "$rc" ]; then
            if ! grep -qF "imagine ls" "$rc"; then
                printf '\n# imagine\n%s\n' "$login_line" >> "$rc"
            fi
        fi
    done

    # Install bash completion
    local comp_dir="$HOME/.local/share/bash-completion/completions"
    mkdir -p "$comp_dir"
    cat > "$comp_dir/imagine" <<'COMP'
_imagine() {
    local cur prev words cword
    _init_completion || return

    if [ "$cword" -eq 1 ]; then
        COMPREPLY=($(compgen -W "install ls done help" -- "$cur"))
        return
    fi

    if [ "${words[1]}" = "done" ]; then
        local imagine_file="${IMAGINE_FILE:-$HOME/.imagine}"
        [ -f "$imagine_file" ] || return
        local dir
        dir="$(pwd -P)"
        # Extract thoughts for the current directory
        local thoughts
        thoughts=$(grep "^${dir} " "$imagine_file" | sed "s|^${dir} ||")
        [ -z "$thoughts" ] && return
        local IFS=$'\n'
        COMPREPLY=($(compgen -W "$thoughts" -- "$cur"))
    fi
}
complete -F _imagine imagine
COMP

    echo "Installed imagine to $bin_dir/imagine"
    echo "Created $IMAGINE_FILE"
    echo "Installed bash completion to $comp_dir/imagine"
    echo "Added login hook to shell profile"
}

cmd_ls() {
    if [ -f "$IMAGINE_FILE" ]; then
        cat "$IMAGINE_FILE"
    fi
}

cmd_done() {
    local args=("$@")
    if [ ${#args[@]} -eq 0 ]; then
        echo "Usage: imagine done [dir] <substring>..."
        exit 1
    fi

    local dir
    dir="$(pwd -P)"
    local first="${args[0]}"

    if [ -d "$first" ]; then
        dir="$(cd "$first" && pwd -P)"
        args=("${args[@]:1}")
    fi

    local pattern="${args[*]}"
    if [ -z "$pattern" ]; then
        echo "Usage: imagine done [dir] <substring>..."
        exit 1
    fi

    if [ ! -f "$IMAGINE_FILE" ]; then
        echo "No imagine file found."
        exit 1
    fi

    # Find first line matching dir + substring (case-insensitive)
    local matched
    matched=$(grep -i -n "^${dir} .*${pattern}" "$IMAGINE_FILE" | head -1)

    if [ -z "$matched" ]; then
        echo "No match for \"$pattern\" in $dir"
        exit 1
    fi

    local lineno="${matched%%:*}"
    local content="${matched#*:}"
    sed -i "${lineno}d" "$IMAGINE_FILE"
    echo "Done: $content"
}

cmd_help() {
    cat <<'HELP'
Usage: imagine [command] [dir] <thought>...

Commands:
  install   Install imagine to ~/.local/bin and set up shell login hook
  ls        Print all recorded thoughts
  done      Mark a thought as done (removes it from the list)
  help      Show this help message

Recording thoughts:
  imagine <thought>...          Record a thought tagged with the current directory
  imagine <dir> <thought>...    Record a thought tagged with the given directory (resolved)

Completing thoughts:
  imagine done <substring>...       Remove first thought matching substring in current dir
  imagine done <dir> <substring>... Remove first thought matching substring in given dir

Environment:
  IMAGINE_FILE    Path to the imagine file (default: ~/.imagine)
                  Export this variable to store thoughts in a different location.
                  Example: export IMAGINE_FILE=~/projects/.imagine
HELP
}

case "${1:-}" in
    install)
        cmd_install
        ;;
    ls)
        cmd_ls
        ;;
    done)
        shift
        cmd_done "$@"
        ;;
    help|-h|--help)
        cmd_help
        ;;
    *)
        # Everything on the CLI is a thought, optionally prefixed by a directory
        args=("$@")
        if [ ${#args[@]} -eq 0 ]; then
            echo "Usage: imagine [install|ls|[dir] <thought>...]"
            exit 1
        fi

        dir="$(pwd)"
        first="${args[0]}"

        if [ -d "$first" ]; then
            dir="$(cd "$first" && pwd -P)"
            args=("${args[@]:1}")
        fi

        thought="${args[*]}"
        echo "$dir $thought" >> "$IMAGINE_FILE"
        ;;
esac
